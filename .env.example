# Copy this file to ".env" (same folder as manage.py) and edit it.
# NEVER share the .env file, upload it anywhere public, or commit it to GitHub.

# ---- required ---------------------------------------------------------------
# Make a secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# True only on your own computer. MUST be False on the live website.
DJANGO_DEBUG=True

# ---- live website -----------------------------------------------------------
# DJANGO_ALLOWED_HOSTS=ayhabd.com,www.ayhabd.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://ayhabd.com,https://www.ayhabd.com
# DJANGO_BEHIND_PROXY=True          # when nginx sits in front of gunicorn (see deploy/nginx.conf)
# DJANGO_HTTPS=True                 # secure cookies (default is True whenever DEBUG is False)
# DJANGO_HSTS_SECONDS=3600          # raise to 31536000 after you confirm HTTPS works everywhere
# DJANGO_ADMIN_URL=ayha-control-room/   # move the admin login away from /admin/ (recommended)
# DJANGO_SERVE_MEDIA=True           # Django serves uploaded photos (fine for a small shop)

# ---- orders: where every order is sent --------------------------------------
# Google Sheet: the Web app URL from google-apps-script/Code.gs (see README, step 6)
# GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec
# Email alert for every order (also set the email lines below on the live server)
# ORDER_ALERT_EMAIL=you@gmail.com
# Optional automatic WhatsApp alert to you (Meta WhatsApp Cloud API, see README)
# WA_TOKEN=
# WA_PHONE_NUMBER_ID=
# WA_OWNER_NUMBER=8801XXXXXXXXX

# Order limit per visitor (stops spam): this many orders in this many minutes
# ORDER_RATE_LIMIT_COUNT=5
# ORDER_RATE_LIMIT_MINUTES=10

# ---- email sending (needed for ORDER_ALERT_EMAIL on the live server) --------
# For Gmail use an "App password": Google Account > Security > 2-Step Verification > App passwords
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-16-letter-app-password
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587

# ---- database (SQLite is the default and is fine for a small shop) ----------
# DB_ENGINE=postgres
# DB_NAME=ayha
# DB_USER=ayha
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
